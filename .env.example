# Copy to .env. Never commit the real file.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0xyour_deployer_key_with_sepolia_eth
ETHERSCAN_API_KEY=optional_for_source_verification

# Where release fees go. Defaults to the deployer.
FEE_RECIPIENT=
# Basis points. 150 = 1.5%. Capped at 500 by the factory.
FEE_BPS=150
